// Copy to a client component mounted once near the app root (e.g.
// app/layout.tsx). Module-level guard, not component-instance-scoped: App
// Router's dev-mode double-invokes effects (mount → cleanup → mount), which
// would otherwise call createGa4Client() — and register the SW — twice in
// quick succession. A useRef guard wouldn't survive the dev-mode remount;
// module-level state does. Only matters in dev — production builds don't
// double-invoke effects.
"use client";
import { useEffect } from "react";
import { createGa4Client } from "@gtmss/ga4-relay/client";

let ga4ClientInitialized = false;

export function Ga4Init() {
  useEffect(() => {
    if (ga4ClientInitialized) return;
    ga4ClientInitialized = true;
    const client = createGa4Client({
      collectUrl: "/api/ga4/collect",
      swScriptUrl: "/ga4-relay/ga4-sw.js", // omit to skip the SW entirely
      swScope: "/ga4-relay/",
    });
    client.track({ event_id: crypto.randomUUID(), name: "page_view", params: {} });
  }, []);
  return null;
}
