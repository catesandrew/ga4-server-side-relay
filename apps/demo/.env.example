# Copy to .env.local for local dev/build. Real deployments must set real
# values — the relay throws at construction time (AC23) if apiSecret or
# tokenSecret is missing, or if rate limiting is enabled with the in-memory
# Store while NODE_ENV=production (which `next build` always sets).
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=replace-with-real-ga4-api-secret
GA4_TOKEN_SECRET=replace-with-a-long-random-string
GA4_ALLOWED_ORIGINS=http://localhost:34577
GA4_COOKIE_DOMAIN=localhost

# Required in production (or during `next build`, since it sets
# NODE_ENV=production) so the relay doesn't reject the in-memory Store.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-real-upstash-token
