{
  "name": "@gtmss/ga4-relay",
  "version": "0.1.0",
  "description": "Server-side GA4 Measurement Protocol relay for Next.js/Vercel, with a first-party cookie/token layer and an offline-capable service worker client.",
  "license": "MIT",
  "author": "Andrew Cates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catesandrew/ga4-server-side-relay.git",
    "directory": "packages/ga4-relay"
  },
  "homepage": "https://github.com/catesandrew/ga4-server-side-relay/tree/main/packages/ga4-relay#readme",
  "bugs": "https://github.com/catesandrew/ga4-server-side-relay/issues",
  "keywords": ["ga4", "google-analytics", "measurement-protocol", "server-side-tagging", "nextjs", "vercel", "service-worker"],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./sw": {
      "types": "./dist/sw/index.d.ts",
      "import": "./dist/sw/index.js"
    },
    "./sw-script": "./dist/sw/index.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "peerDependencies": {
    "next": ">=15.1.0"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "next": "^15.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
